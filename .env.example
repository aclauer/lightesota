# Copy to .env (never committed) or export in the server's environment.
# Anthropic API key for the pattern-writing agent. Everything else works without it.
ANTHROPIC_API_KEY=
# Port for the web UI + WebSocket + API (default 8787)
PORT=8787
# Where rig/scenes/patterns are stored (default ./data)
# LIGHTESOTA_DATA=/var/lib/lightesota
# Fixed admin token (default: generated once and stored in data/auth.json)
# LIGHTESOTA_ADMIN_TOKEN=
# Set to 0 to require a token even from localhost
# LIGHTESOTA_LOCALHOST_ADMIN=1
