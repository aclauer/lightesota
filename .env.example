# Copy to .env (never committed) or export in the server's environment.
# Separate Hermes subscription proxy (company Nous authorization managed outside this app).
LIGHTESOTA_HERMES_BASE_URL=http://127.0.0.1:8645/v1
# Optional key for a separately authenticated HTTPS reverse proxy; the Hermes proxy itself has no auth. Never copy upstream OAuth.
LIGHTESOTA_HERMES_PROXY_KEY=
# Used only when an administrator explicitly selects Anthropic rollback in Settings.
ANTHROPIC_API_KEY=
# Port for the web UI + WebSocket + API (default 8787)
PORT=8787
# Where rig/scenes/patterns are stored (default ./data)
# LIGHTESOTA_DATA=/var/lib/lightesota
# Fixed admin token (default: generated once and stored in data/auth.json)
# LIGHTESOTA_ADMIN_TOKEN=
# Preview always blocks physical output AND provider requests.
LIGHTESOTA_PREVIEW=1
# Remain off until single-sender cutover and attended commissioning are verified.
LIGHTESOTA_OUTPUT_COMMISSIONED=0
LIGHTESOTA_HAZE_COMMISSIONED=0
# Dedicated Giskard integration; default disabled, never reuse browser/HA tokens.
LIGHTESOTA_GISKARD_ENABLED=0
LIGHTESOTA_GISKARD_TOKEN=
LIGHTESOTA_GISKARD_TEAM_ID=
# Current #giskard channel; operator must verify team/channel and explicit U/W user IDs.
LIGHTESOTA_GISKARD_CHANNEL_ID=C0CB4RFQ55Y
LIGHTESOTA_GISKARD_USER_IDS=
